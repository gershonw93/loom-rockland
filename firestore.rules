rules_version = '2';

// All access to enrollment data goes through the Next.js server using the
// Firebase Admin SDK, which bypasses these rules. Client SDK access is denied
// entirely so sensitive enrollment / health data is never publicly readable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
