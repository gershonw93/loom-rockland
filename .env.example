# ─── Firebase Admin (server-side only) ──────────────────────────────────────
# From Firebase console → Project settings → Service accounts → "Generate new
# private key". Open the downloaded JSON and copy these three values.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the literal \n escapes from the JSON — the app converts them to newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Storage bucket name (Firebase console → Storage). Usually
# <project-id>.appspot.com or <project-id>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# ─── Admin portal ───────────────────────────────────────────────────────────
# Password that protects the /admin page and CSV export. Choose something strong.
ADMIN_PASSWORD=change-me-to-a-strong-password
